/* Base Styles & Color Variables */
:root {
  --bg-color: #fff5f7;        /* Very light soft pink background */
  --card-bg: #ffffff;         /* White background for cards */
  --primary: #f48fb1;         /* Main baby pink accent */
  --primary-hover: #ec407a;   /* Slightly deeper pink for hover states */
  --text-color: #333333;      /* Dark gray text for high contrast */
  --border-color: #fce4ec;    /* Subtle pink border */
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: var(--bg-color);
  color: var(--text-color);
  line-height: 1.6;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* Layout Container */
.container {
  width: 90%;
  max-width: 650px;
  margin: 0 auto;
}

/* Header Section */
.header {
  background-color: var(--primary);
  color: #ffffff;
  padding: 3rem 1rem;
  text-align: center;
  border-bottom: 4px solid #f06292;
}

.header h1 {
  font-size: 2.2rem;
  margin-bottom: 0.5rem;
}

.bio {
  font-size: 1.1rem;
  max-width: 500px;
  margin: 0 auto;
  opacity: 0.95;
}

/* Main Cards Section */
main {
  flex: 1;
  padding: 2rem 0;
}

.card {
  background-color: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.03);
}

.card h2 {
  color: var(--primary-hover);
  font-size: 1.4rem;
  margin-bottom: 1rem;
  border-bottom: 2px solid var(--bg-color);
  padding-bottom: 0.3rem;
}

/* Interests List */
.interests-list {
  list-style-type: none;
}

.interests-list li {
  padding: 0.5rem 0;
  border-bottom: 1px dashed var(--border-color);
}

.interests-list li:last-child {
  border-bottom: none;
}

/* Contact Links */
.contact-link {
  display: inline-block;
  margin-top: 0.5rem;
  color: var(--primary-hover);
  font-weight: bold;
  text-decoration: none;
}

.contact-link:hover,
.contact-link:focus {
  text-decoration: underline;
}

/* Footer Section */
.footer {
  text-align: center;
  padding: 1.5rem 0;
  font-size: 0.85rem;
  color: #777777;
}

/* Mobile & Screen Adjustments */
@media (max-width: 480px) {
  .header {
    padding: 2rem 1rem;
  }

  .header h1 {
    font-size: 1.8rem;
  }
}
